# QloApps Environment Configuration
# Copy this file to .env and update with your actual values

# Database Configuration
DB_SERVER=db
DB_NAME=qloapps
DB_USER=qloapps_user
DB_PASSWORD=qloapps_pass
DB_ROOT_PASSWORD=rootpassword
DB_PREFIX=qlo_

# Application Settings
# For production, set to your domain (e.g., hotel.yourdomain.com)
DOMAIN=localhost
PROTOCOL=http

# Admin Configuration (set during installation)
# These are example values - you'll set them during QloApps installation wizard
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=SecurePassword123!

# Hotel Configuration - SINI Campus
HOTEL_NAME=Sarnath International Nyingma Institute Campus
HOTEL_ADDRESS=INDIA SA 14/52 P-2, Baraipur Sarnath
HOTEL_CITY=Varanasi
HOTEL_STATE=Uttar Pradesh
HOTEL_COUNTRY=India
HOTEL_POSTAL_CODE=221007
TIMEZONE=Asia/Kolkata
DEFAULT_LANGUAGE=en
CURRENCY=INR

# Email Configuration (Optional - configure during setup)
SMTP_SERVER=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_ENCRYPTION=tls

# Performance Settings
PHP_MEMORY_LIMIT=128M
PHP_UPLOAD_MAX_FILESIZE=16M
PHP_MAX_EXECUTION_TIME=500

# Debug Mode (Set to 0 in production)
DEBUG_MODE=0
